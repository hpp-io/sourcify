{
  "name": "sourcify-backfill",
  "version": "1.0.0",
  "private": true,
  "description": "Backfill verified contracts from Blockscout into Sourcify",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node dist/index.js --mode oneshot",
    "fix": "run-s fix:*",
    "fix:prettier": "prettier \"./**/*.ts\" --write",
    "fix:lint": "eslint . --ext .ts --fix",
    "check": "run-s check:*",
    "check:eslint": "eslint . --ext .ts",
    "check:prettier": "prettier \"./**/*.ts\" --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argotorg/sourcify.git"
  },
  "keywords": [
    "sourcify",
    "ethereum",
    "blockchain",
    "smart-contracts",
    "backfill"
  ],
  "author": "sourcify",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/argotorg/sourcify/issues"
  },
  "homepage": "https://github.com/argotorg/sourcify#readme",
  "dependencies": {
    "dotenv": "16.6.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/node": "22.19.10",
    "@types/node-cron": "^3.0.11",
    "npm-run-all2": "^7.0.2",
    "typescript": "5.8.2"
  }
}
